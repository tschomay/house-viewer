# Access gate. Without it, only visitors who enter their own Gemini key can use
# the AI steps / auto-import (the demo house and on-device depth always work).
# Anyone who enters this password uses the keys below.
ACCESS_PASSWORD=

# Google Gemini (room graph + photo matching)
GEMINI_API_KEY=
# Optional override; default is gemini-3.1-pro-preview
GEMINI_MODEL=

# Optional: server-side Depth Anything V2 (Large) via Replicate.
# On-device depth (Depth Anything V2 Small in the browser) needs no key.
REPLICATE_API_TOKEN=
# Optional override, "owner/name" or "owner/name:version"
REPLICATE_DEPTH_MODEL=
